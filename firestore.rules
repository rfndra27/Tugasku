rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user matches target userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles collection: profiles/{userId}
    // Spark Plan (no Cloud Functions): streak, AI quota, and premium simulation
    // are written directly by the account owner via client transactions.
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Profiles cannot be deleted directly by client
    }

    // Phone -> email lookup used by phone + password login before auth exists.
    match /phone_lookup/{phoneId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Payments collection: client-side simulation on Spark Plan
    match /payments/{paymentId} {
      allow read, create, update: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid);
      allow delete: if false;
    }

    match /group_invitations/{invitationId} {
      allow create: if isAuthenticated() && request.resource.data.sender_name != null;
      allow read: if isAuthenticated() && resource.data.recipient_user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipient_user_id == request.auth.uid;
      allow delete: if false;
    }

    // User's private subcollections:
    // users/{userId}/courses/{courseId}
    // users/{userId}/tasks/{taskId}
    // users/{userId}/tasks/{taskId}/subtasks/{subtaskId}
    // users/{userId}/group_projects/{projectId}
    // users/{userId}/group_projects/{projectId}/deliverables/{deliverableId}
    // users/{userId}/group_projects/{projectId}/activity_logs/{logId}
    // users/{userId}/group_members/{memberId}
    // users/{userId}/class_schedules/{scheduleId}
    // users/{userId}/personal_agendas/{agendaId}
    // users/{userId}/elearning_configs/{configId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
